{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@veil/sdk": ["./vendor/veil-sdk-stub/index.js"],
      "@veil/sdk/*": ["./vendor/veil-sdk-stub/*"]
    }
  },
  "include": ["src/**/*", "vendor/veil-sdk-stub/**/*"]
}
