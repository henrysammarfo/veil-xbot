# Required
OPENAI_API_KEY=
TINYFISH_API_KEY=

# Brand
VEIL_DEMO_URL=https://veil-reviewer.vercel.app
VEIL_API_UPSTREAM=http://51.103.219.168:8787
VEIL_WAITLIST_URL=
MAGOS_REPO_URL=https://github.com/henrysammarfo/magmoslabs
MAGOS_DEMO_URL=https://magmoslabs.vercel.app
MAGOS_X_HANDLE=henrysammarfo

# Paid growth — X Premium (blue tick) + ad spend
X_PREMIUM_BUDGET_USD=8
MAGOS_AD_BUDGET_USD=500
PAID_GROWTH_BUDGET_USD=500

# OSS editor stack (freecut / VibeVoice / voicebox / HyperFrames / Diffusion Studio / ad-maker)
TRANSCRIBE_BACKEND=whisper
VIBEVOICE_ASR_URL=
VOICEBOX_URL=
FREECUT_FILLERS=1
# Diffusion Studio — https://github.com/diffusionstudio/editor (agent TSX → dapi)
DIFFUSION_STUDIO=1
DIFFUSION_STUDIO_EXECUTE=0
DIFFUSION_GEN=1
HEYGEN_API_KEY=
HEYGEN_AUTO=1
OPENMONTAGE_AUTO=1
# Speech stack (npm run services:up or services:up:local)
VOICEBOX_URL=http://127.0.0.1:8780
VIBEVOICE_ASR_URL=http://127.0.0.1:8780/transcribe
# Pack / ship behavior
SOCIAL_MAX=1
SOCIAL_MAX_WATCH=3
THRILLER_VIDEO=1
SITE_ADS_VIDEO=1
CONTEXT_DEV_API_KEY=

# QA sandbox (optional — full account test)
SANDBOX_TEST_EMAIL=
SANDBOX_TEST_PASSWORD=

# Paid studio — add when budget allows (see INTEGRATIONS.md)
FAL_API_KEY=
KLING_API_KEY=
HYPERFRAMES_AUTO=0
ELEVENLABS_API_KEY=

# Venice AI (venice.ai) — text, image, audio, video. Alias: VERNICE_* still works.
LLM_PROVIDER=venice
VENICE_API_KEY=
# VERNICE_API_KEY=
VENICE_API_URL=https://api.venice.ai/api/v1
VENICE_TEXT_MODEL=venice-uncensored
VENICE_IMAGE_MODEL=flux-dev
VENICE_TTS_MODEL=tts-kokoro
VENICE_TTS_VOICE=am_michael
VENICE_VIDEO_MODEL=seedance-2-0-mini-text-to-video
# Walkthrough: product-only by default. Smart capture ON. Face PiP only if both set:
# WALKTHROUGH_AVATAR=1
# PRESENTER_VIDEO=1
WALKTHROUGH_AVATAR=0
PRESENTER_VIDEO=0
SMART_CAPTURE=1
# Credit budget — 8000 credits ≈ $8000 prepaid pool (adjust to your account)
VENICE_CREDIT_BUDGET=8000
VENICE_SESSION_BUDGET_USD=25
VENICE_AUTO_MAX_USD=2
VENICE_DEFAULT_TIER=standard
FLOCKAI_API_URL=
FLOCKAI_API_KEY=
FLOCKAI_MODEL=
# Smart stack: Venice → OpenAI (+ optional Flock) + TinyFish research
# Ads: Magmos default AD_ENGINE=stack = formats.json static → remix Goose refs
#   (+ companion skill JSON). $0 GooseWorks. AD_ENGINE=local = concept compositor only.
# AD_ENGINE=venice = old text-in-image (garbles copy — avoid)
AD_ENGINE=stack
AD_FORMAT=static
GOOSE_GRAPHICS=1
# Edit-on-reference cascade (FAL alternate). Venice is primary.
EDIT_ENGINE=venice,openai,fal
VENICE_EDIT_MODEL=qwen-edit
# Set HF_RENDER=1 to run npx hyperframes render on video-format scaffolds (slow)
HF_RENDER=0
LOCAL_AD_PLATE=1
OPENAI_MODEL=gpt-4o-mini

# Sui sandbox — wallet + testnet faucet
SUI_NETWORK=testnet
SUI_RPC_URL=
SANDBOX_FAUCET_URL=
SANDBOX_DUSDC_FAUCET_URL=https://tally.so/r/Xx102L
SANDBOX_WALLET=1
SANDBOX_FUND_SUI=0.25
SANDBOX_FUND_DUSDC=25
SANDBOX_GOTO_TIMEOUT_MS=120000
SANDBOX_WAIT_UNTIL=domcontentloaded
# Retina capture for judge-ready demos
SANDBOX_CAPTURE_DEVICE=desktop
SANDBOX_CAPTURE_WIDTH=1920
SANDBOX_CAPTURE_HEIGHT=1080
SANDBOX_CAPTURE_FULLSCREEN=1
SANDBOX_DEVICE_SCALE=1
SANDBOX_HEADED=1
SANDBOX_PLAYWRIGHT_BROWSERS_PATH=
SMART_CAPTURE=1
DEMO_CAPTIONS=0
VEIL_API_URL=http://127.0.0.1:8787
# MetaMask — path to unpacked extension (EVM projects with walletMode metamask)
SANDBOX_METAMASK_EXTENSION_PATH=
# EVM sandbox
EVM_CHAIN_ID=11155111
EVM_RPC_URL=
SANDBOX_MIN_ETH=0.005
# Demo pipeline — Venice b-roll + voiceover in editor
DEMO_VENICE_BROLL=1
DEMO_VOICEOVER=1
DEMO_VENICE_TIER=standard
DEMO_VENICE_VIDEO_MODEL=seedance
DEMO_VENICE_FORCE=0

# Dashboard
XBOT_PORT=3947
